# Este backend está escrito en Dart puro y NO lee archivos .env
# automáticamente (a diferencia de la versión anterior en Node.js).
# Dart lee directamente las variables de entorno del sistema operativo.
#
# Este archivo es solo de referencia, para que sepas qué variables existen
# y cómo se configuran en cada sistema operativo.
#
# ---------------------------------------------------------------------
# ADMIN_USERS
# Lista de usuarios y contraseñas del panel de administración, separados
# por comas. Formato: usuario1:clave1,usuario2:clave2
# Si no se define, se usa por defecto: admin:maykel2026
#
# PORT
# Puerto donde escucha el servidor. Si no se define, se usa 8080.
# ---------------------------------------------------------------------

# En Linux / macOS (bash o zsh), antes de correr el servidor:
#   export ADMIN_USERS="admin:maykel2026,juan:clave123,maria:clave456"
#   export PORT=8080
#   dart run bin/server.dart

# En Windows (PowerShell), antes de correr el servidor:
#   $env:ADMIN_USERS = "admin:maykel2026,juan:clave123,maria:clave456"
#   $env:PORT = "8080"
#   dart run bin/server.dart

# También puedes definirlas en una sola línea al ejecutar (Linux/macOS):
#   ADMIN_USERS="admin:maykel2026" PORT=8080 dart run bin/server.dart

