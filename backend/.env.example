# Copia este archivo como backend/.env y completa tus datos.
# El backend lee backend/.env al arrancar (paquete dotenv) y también las
# variables de entorno del sistema. backend/.env NO se sube a GitHub.

# Puerto del servidor (Render lo define solo).
PORT=8080

# ---- Base de datos: opción A, una sola URL (Render, Neon, Heroku...) ----
# Si está definida, se ignoran las variables DB_* de abajo.
# Si el host no es localhost y la URL no dice sslmode, se usa SSL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base?sslmode=require

# ---- Base de datos: opción B, desarrollo local ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maykel_repuestos_db
DB_USER=postgres
DB_PASS=tu_clave_de_postgres

# ---- Acceso al panel ----
# Usuarios "propietario" con acceso total, además de los de la tabla
# usuarios. Formato: usuario1:clave1,usuario2:clave2
# Si no se define, el panel solo acepta los usuarios de la base de datos.
# ADMIN_USERS=admin:UnaClaveSegura

# ---- Sincronización de inventario (POST /api/v1/sync/inventory) ----
# Token que debe enviar el agente local en "Authorization: Bearer <token>".
# Si no se define, toda sincronización se rechaza.
# SYNC_API_TOKEN=un_token_largo_y_secreto
